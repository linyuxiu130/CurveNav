# Single-scene RTX 2080 Ti diagnostic profile.
# Keep the simulator on GPU0 and shard one logical policy batch over GPU1--4.
# Single-scene B24 throughput diagnostic; not the official B16 result profile.
NAVBENCH_GPUS=0
NAVBENCH_SERVER_GPUS=1,2,3,4
NAVBENCH_NUM_ENVS=24
NAVBENCH_CPU_THREADS_PER_WORKER=6
NAVBENCH_LAUNCH_STAGGER=0
NAVBENCH_GPU_POLL_SECONDS=10
