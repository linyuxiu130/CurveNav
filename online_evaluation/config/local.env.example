# Copy this file to config/local.env. The local file is ignored by Git.
NAVBENCH_EVAL_PYTHON=/path/to/isaaclab/bin/python
NAVBENCH_SERVER_PYTHON=/path/to/navbench-server/bin/python
NAVBENCH_VIPLANNER_PYTHON=/path/to/viplanner/bin/python
NAVBENCH_WEIGHT_ROOT=/path/to/checkpoints
NAVBENCH_SCENE_ROOT=/path/to/Scene-N1/n1_eval_scenes
NAVBENCH_XNAVDP_ROOT=/path/to/NavDP/baselines/x-navdp
ACADOS_SOURCE_DIR=/path/to/pinned/acados
# Set OMNI_KIT_ACCEPT_EULA=YES only after accepting NVIDIA's Omniverse EULA.
NAVBENCH_GPUS=0,1,2,3,4,5,6,7
NAVBENCH_LAUNCH_STAGGER=2.0
NAVBENCH_CPU_THREADS_PER_WORKER=4
NAVBENCH_GPU_POLL_SECONDS=10
NAVBENCH_CACHE_ROOT=~/.cache/navbench
# Optional Omniverse Kit settings required by the installed host runtime.
# Example for the NVIDIA-documented Vulkan 535.256+ version-reporting issue:
# NAVBENCH_EVAL_KIT_ARGS=--/rtx/verifyDriverVersion/enabled=false
# Frozen pointgoal-v2 result contract.
NAVBENCH_NUM_ENVS=16
# Optional deterministic scene sharding for multiple hosts.
# NAVBENCH_SHARD_INDEX=0
# NAVBENCH_SHARD_COUNT=1
