# RTX 2080 Ti throughput profile. Paths and model selection remain in local.env.
# Official pointgoal-v2 B16 profile for the 8x2080 Ti host.
# Full-suite measurement reached 238 GiB used memory and exhausted complex-scene
# VRAM with five evaluators. Four resident scenes preserve host and device margin;
# policy servers remain isolated on GPUs 5--7.
NAVBENCH_GPUS=0,1,2,3,4
NAVBENCH_SERVER_GPUS=5,6,7,5,6
NAVBENCH_NUM_ENVS=16
NAVBENCH_CPU_THREADS_PER_WORKER=6
NAVBENCH_LAUNCH_STAGGER=10.0
NAVBENCH_MAX_WORKERS=4
NAVBENCH_GPU_POLL_SECONDS=10
NAVBENCH_POLICY_GPU_SLOTS=2
